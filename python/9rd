from tkinter import *
from tkinter import messagebox

window = Tk()

def myFunc1():
    if chk1.get() == 1:
        messagebox.showinfo("", "파이썬  눌렀어요.")
    else:
        messagebox.showinfo("", "파이썬  껐어요.")

def myFunc2():
    if chk2.get() == 1:
        messagebox.showinfo("", "CTT  눌렀어요.")
    else:
        messagebox.showinfo("", "CTT 껐어요.")

def myFunc3():
    if chk3.get() == 1:
        messagebox.showinfo("", "JavaScript  눌렀어요.")
    else:
        messagebox.showinfo("", "JavaScript 껐어요.")

chk1 = IntVar()
chk2 = IntVar()
chk3 = IntVar()

cb1 = Checkbutton(window, text="파이썬", variable=chk1, command=myFunc1)
cb2 = Checkbutton(window, text="CTT", variable=chk2, command=myFunc2)
cb3 = Checkbutton(window, text="JavaScript", variable=chk3, command=myFunc3)

cb1.pack()
cb2.pack()
cb3.pack()

window.mainloop()
